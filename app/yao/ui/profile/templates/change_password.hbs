<div class="modal-dialog">
  <button type="button" class="btn btn-clean btn-user-cancel btn-cancel-primary"></button>
  <div class="modal-content">
    <div class="modal-header">
      <h4 class="header-dashed-text modal-title">{{localize 'registration.change_password_title'}}</h4>
    </div>
    <div class="modal-body">
      <div class="prompt-form">
        <div class="form-group">
          <label>{{localize 'registration.change_password_current_password_label'}}</label>
          <input type="password" class="form-control password-current" required placeholder="{{localize 'registration.change_password_current_password_label'}}">
        </div>
        <div class="form-group" style="margin-bottom: 0;">
          <label>{{localize 'registration.change_password_password_label'}}</label>
          <input type="password" class="form-control password" required placeholder="{{localize 'registration.change_password_password_label'}}">
        </div>
        <div class="form-group">
          <input type="password" class="form-control password-confirm" required placeholder="{{localize 'registration.change_password_password_confirmation_label'}}">
        </div>
        <div class="form-control-buttons">
          <button class="btn btn-clean btn-clean-confirm prompt-submit">{{localize 'common.save_button_label'}}</button>
        </div>
      </div>

      <div class="prompt-submitted">
        <div class="activity-animation"><div class="activity-animation-image"></div></div>
        <h2 class="prompt-title">{{localize 'common.loading_dialog_one_moment_label'}}</h2>
      </div>

      <div class="prompt-success">
        <div class="icon-container"><i class="fa fa-check"></i></div>
        <h2 class="prompt-title">{{localize 'common.success_title'}}</h2>
        <p class="prompt-message">{{localize 'registration.change_password_success'}}</p>
      </div>

      <div class="prompt-error">
        <div class="icon-container"><i class="fa fa-times"></i></div>
        <h2 class="prompt-title">{{localize 'common.error_occurred_title'}}</h2>
        <p class="prompt-message error-message"></p>
        <button class="btn btn-clean btn-clean-cancel prompt-error-back">{{localize 'common.back_button_label'}}</button>
      </div>
    </div>
  </div>
</div>
